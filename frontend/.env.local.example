# Where the FastAPI backend runs, as seen from the Next.js server. The browser calls /api/* on the
# same origin and Next proxies it here, so only the frontend port needs to be reachable.
BACKEND_URL=http://127.0.0.1:8000

# Optional: call a backend on another origin directly from the browser instead of the proxy.
# The backend's CORS_ORIGINS must then include the frontend's origin.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Optional (next dev only): extra hostnames allowed to load dev assets, comma-separated.
# *.ts.net (Tailscale MagicDNS) is always allowed.
# DEV_ORIGINS=100.102.10.69
