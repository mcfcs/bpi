# Frontend settings. On Vercel, set these as environment variables. Locally, copy to frontend/.env.local.

# Where the backend runs. Only the Next.js server calls it; /api/* in the browser is proxied there.
BACKEND_URL=https://alamkansya-api.onrender.com

# Optional password for the whole site, as "user:password" (HTTP basic auth). Leave empty to turn it off.
DEMO_BASIC_AUTH=

# Optional. Must equal the backend's BACKEND_SHARED_SECRET; added to every /api call it forwards.
BACKEND_SHARED_SECRET=
