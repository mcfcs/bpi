# Settings for loading the database (backend/scripts/supabase_setup.py). Copy this file to
# backend/.env.supabase, fill it in, then run from the repo root:
#     python backend/scripts/supabase_setup.py --check
#     python backend/scripts/supabase_setup.py
# Never commit backend/.env.supabase.

# 1. Supabase → your project → Connect → "Session pooler" (port 5432, NOT 6543), with your password.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# 2. Search model. Must match EMBEDDING_PROVIDER / EMBEDDING_MODEL on the backend, or search finds nothing.
EMBEDDING_PROVIDER=hashing
#    Bedrock instead (then also fill section 3):
#EMBEDDING_PROVIDER=bedrock
#EMBEDDING_MODEL=global.cohere.embed-v4:0
#AWS_REGION=ap-southeast-1

# 3. Only for EMBEDDING_PROVIDER=bedrock: an AWS access key that may call Bedrock, or leave both blank and
#    set AWS_PROFILE to use an AWS sign-in on this machine.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#AWS_PROFILE=
