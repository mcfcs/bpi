# Backend settings. On Render, set these as environment variables. To run locally, copy this file to
# backend/.env and fill it in (never commit backend/.env).

# Supabase → Connect → Session pooler string (port 5432, not 6543), with the database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Keeps the persona menu (Ben, Dino, Carla, Ana) so viewers can switch roles without accounts.
DEMO_MODE=true

# Any long random string (e.g. `openssl rand -hex 32`); signs the app's own demo sign-in tokens.
SUPABASE_JWT_SECRET=change-me-to-a-long-random-string

# Optional. When set, every /api call except /api/health must carry this value in X-Demo-Key, which the
# frontend adds when it has the same BACKEND_SHARED_SECRET. Leave empty locally.
BACKEND_SHARED_SECRET=

# Brief writer and search. Default: built-in templates and word matching (no external services).
LLM_PROVIDER=offline
EMBEDDING_PROVIDER=hashing

# To use Claude and Cohere on Amazon Bedrock instead (needs an AWS account with access to both models).
# The database must then be loaded with the same EMBEDDING_PROVIDER / EMBEDDING_MODEL (see README.md).
# LLM_PROVIDER=bedrock
# AWS_REGION=ap-southeast-1
# AWS_BEDROCK_MODEL=global.anthropic.claude-sonnet-5-5
# LLM_EFFORT=medium
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=global.cohere.embed-v4:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
