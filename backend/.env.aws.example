# Amazon Bedrock experiment (model-serve branch; docs/AWS_PLAN.md phase a).
# Copy the lines you need into backend/.env.local (git-ignored). Never put AWS keys in files:
# sign in with `aws configure sso` and set AWS_PROFILE, or use temporary credentials.

# Claude on Bedrock (Anthropic SDK Mantle client). pip install -r requirements-aws.txt
LLM_PROVIDER=bedrock
AWS_REGION=ap-southeast-1
AWS_PROFILE=bpi-experiment
# claude-opus-5-5 becomes anthropic.claude-opus-5-5. From Singapore, Opus 5.5 is offered through
# global cross-region inference (check the console for the exact profile ID, e.g.
# global.anthropic.claude-opus-5-5); claude-sonnet-5 runs in-region.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# Optional: retry refusals on another model (client-side; Bedrock has no server-side fallback).
# BEDROCK_FALLBACK_MODEL=claude-opus-4-8

# Optional: Cohere Embed v4 on Bedrock (sends finding text to AWS; run the eval sweep first).
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=cohere.embed-v4:0
